{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lodgeit-labs.org/sbrm/bridge/v1/schema/bridge-mapping.json",
  "title": "SBRM \u2192 Framework Bridge Mapping Node (direct_atom)",
  "description": "Schema for direct_atom bridge fact-nodes under GLOBAL_NOTES/BRIDGE/<framework_id>/<taxonomy_version>/<sbrm_code>.md. Validates the YAML front-matter of a 1:1 mapping from a specific SBRM code to a specific framework concept. Identity tuple per CLAWDOG/113 D1: (sbrm_code, framework_id, taxonomy_version, period_applicability) \u2014 four atoms kept SEPARATE per Lesson #36.",
  "type": "object",
  "required": [
    "@context",
    "@id",
    "ontological_class",
    "bridge",
    "cryptographic_anchor",
    "cybernetic_state",
    "helm_mutations"
  ],
  "properties": {
    "@context": {
      "type": "string",
      "const": "https://lodgeit-labs.org/sbrm/bridge/v1"
    },
    "@id": {
      "type": "string",
      "pattern": "^urn:sbrm:bridge:[a-z0-9_]+:[a-z0-9_]+:sbrm-[0-9]+$",
      "description": "Canonical URN: urn:sbrm:bridge:<framework_id>:<taxonomy_version>:sbrm-<NNNN>. Example: urn:sbrm:bridge:frs_105_micro:frc_v2026:sbrm-4101."
    },
    "ontological_class": {
      "type": "string",
      "const": "BridgeMapping"
    },
    "bridge": {
      "type": "object",
      "required": [
        "sbrm_code",
        "framework_id",
        "taxonomy_version",
        "period_applicability",
        "framework_concept",
        "mapping_kind",
        "statement_role",
        "confidence"
      ],
      "properties": {
        "sbrm_code": {
          "type": "string",
          "pattern": "^sbrm_[0-9]+$",
          "description": "The bare LodgeiT SBRM atom. Lesson #36: never fuse with framework_id."
        },
        "framework_id": {
          "type": "string",
          "enum": [
            "frs_105_micro",
            "frs_102_1a_small",
            "au_sbr_gp",
            "au_aasb_ifrs",
            "ifrs_full"
          ],
          "description": "Reporting framework identifier (separate atom)."
        },
        "taxonomy_version": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "Taxonomy version identifier, e.g. frc_v2026, frc_v2024 (period-scoped per Standing Rule #6)."
        },
        "period_applicability": {
          "oneOf": [
            {
              "type": "string",
              "const": "ongoing"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.\\.[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          ],
          "description": "When this mapping is valid. 'ongoing' wildcard for current-period filings, or YYYY-MM-DD..YYYY-MM-DD bounded."
        },
        "framework_concept": {
          "type": "string",
          "minLength": 1,
          "description": "The target taxonomy concept identifier with namespace prefix, e.g. 'uk-core:TurnoverRevenue'."
        },
        "mapping_kind": {
          "type": "string",
          "const": "direct_atom"
        },
        "statement_role": {
          "type": "string",
          "enum": [
            "PL_REVENUE",
            "PL_EXPENSE",
            "PL_COMPUTED",
            "BS_ASSET",
            "BS_LIABILITY",
            "EQUITY",
            "EQUITY_MOVEMENT",
            "OCI",
            "CASHFLOW",
            "NOTE",
            "BOILERPLATE"
          ],
          "description": "Where this concept lives in the framework's statement structure. NN#5: codes reachable from comprehensive_income ancestry must use OCI or EQUITY_MOVEMENT, never PL_*."
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "verifies_against": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "anchor"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "anchor": {
            "type": "string"
          },
          "sidecar": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "description": "Optional Standing-Rule-#11 verbatim-claim declarations when the framework_concept string is quoted byte-for-byte from a taxonomy XSD."
    },
    "cryptographic_anchor": {
      "type": "object",
      "required": [
        "hash_algorithm",
        "hash_target",
        "content_hash"
      ],
      "properties": {
        "hash_algorithm": {
          "type": "string",
          "const": "SHA-256"
        },
        "hash_target": {
          "type": "string",
          "enum": [
            "self",
            "source"
          ]
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$|^PLACEHOLDER_CONTENT_HASH$"
        },
        "ipfs_cid": {
          "type": "string"
        },
        "hash_domain": {
          "type": "string",
          "enum": [
            "pre_anchor_draft",
            "anchored_v1",
            "anchored_v2"
          ]
        }
      }
    },
    "cybernetic_state": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "canonical",
            "deprecated"
          ]
        }
      },
      "additionalProperties": false
    },
    "helm_mutations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mutation_id",
          "agent_id",
          "authority",
          "justification"
        ],
        "properties": {
          "mutation_id": {
            "type": "string"
          },
          "agent_id": {
            "type": "string"
          },
          "authority": {
            "type": "string"
          },
          "justification": {
            "type": "string"
          },
          "timestamp_utc": {
            "type": "string",
            "format": "date-time"
          },
          "ledger_id": {
            "type": "string"
          },
          "mutation_type": {
            "type": "string"
          },
          "previous_content_hash": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "semantic_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rel",
          "target"
        ],
        "properties": {
          "rel": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}