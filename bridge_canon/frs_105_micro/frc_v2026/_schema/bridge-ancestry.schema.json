{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lodgeit-labs.org/sbrm/bridge/v1/schema/bridge-ancestry.json",
  "title": "SBRM \u2192 Framework Bridge Ancestry-Subsume Rule (ancestry_subsume)",
  "description": "Schema for ancestry_subsume bridge fact-nodes under GLOBAL_NOTES/BRIDGE/<framework_id>/<taxonomy_version>/_ancestry_/<ancestor_slug>.md. Declares that all SBRM codes reachable from the named LodgeiT-ontology ancestor slug subsume to a single framework concept (modulo direct_atom overrides). Collapses what would otherwise be hand-curated 1:1 rows for an entire subtree.",
  "type": "object",
  "required": [
    "@context",
    "@id",
    "ontological_class",
    "bridge_ancestry",
    "cryptographic_anchor",
    "cybernetic_state",
    "helm_mutations"
  ],
  "properties": {
    "@context": {
      "type": "string",
      "const": "https://lodgeit-labs.org/sbrm/bridge/v1"
    },
    "@id": {
      "type": "string",
      "pattern": "^urn:sbrm:bridge-ancestry:[a-z0-9_]+:[a-z0-9_]+:[a-z0-9_]+$",
      "description": "Canonical URN: urn:sbrm:bridge-ancestry:<framework_id>:<taxonomy_version>:<ancestor_slug>."
    },
    "ontological_class": {
      "type": "string",
      "const": "BridgeAncestrySubsume"
    },
    "bridge_ancestry": {
      "type": "object",
      "required": [
        "ancestor_slug",
        "framework_id",
        "taxonomy_version",
        "period_applicability",
        "framework_concept",
        "mapping_kind",
        "statement_role"
      ],
      "properties": {
        "ancestor_slug": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "LodgeiT-ontology slug acting as the subsuming ancestor. Every SBRM code whose ancestry chain (via parent/2 in full_sbrm_physics.pl) reaches this slug routes here unless overridden by a direct_atom mapping."
        },
        "framework_id": {
          "type": "string",
          "enum": [
            "frs_105_micro",
            "frs_102_1a_small",
            "au_sbr_gp",
            "au_aasb_ifrs",
            "ifrs_full"
          ]
        },
        "taxonomy_version": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "period_applicability": {
          "oneOf": [
            {
              "type": "string",
              "const": "ongoing"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.\\.[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          ]
        },
        "framework_concept": {
          "type": "string",
          "minLength": 1
        },
        "mapping_kind": {
          "type": "string",
          "const": "ancestry_subsume"
        },
        "statement_role": {
          "type": "string",
          "enum": [
            "PL_REVENUE",
            "PL_EXPENSE",
            "PL_COMPUTED",
            "BS_ASSET",
            "BS_LIABILITY",
            "EQUITY",
            "EQUITY_MOVEMENT",
            "OCI",
            "CASHFLOW",
            "NOTE",
            "BOILERPLATE"
          ]
        },
        "overrides_at": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sbrm_[0-9]+$"
          },
          "description": "List of SBRM codes within this ancestry subtree that take a direct_atom override INSTEAD of this subsume rule. Direct_atom mappings always win over ancestry_subsume."
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "verifies_against": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "anchor"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "anchor": {
            "type": "string"
          },
          "sidecar": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "cryptographic_anchor": {
      "type": "object",
      "required": [
        "hash_algorithm",
        "hash_target",
        "content_hash"
      ],
      "properties": {
        "hash_algorithm": {
          "type": "string",
          "const": "SHA-256"
        },
        "hash_target": {
          "type": "string",
          "enum": [
            "self",
            "source"
          ]
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$|^PLACEHOLDER_CONTENT_HASH$"
        },
        "ipfs_cid": {
          "type": "string"
        },
        "hash_domain": {
          "type": "string",
          "enum": [
            "pre_anchor_draft",
            "anchored_v1",
            "anchored_v2"
          ]
        }
      }
    },
    "cybernetic_state": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "canonical",
            "deprecated"
          ]
        }
      },
      "additionalProperties": false
    },
    "helm_mutations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mutation_id",
          "agent_id",
          "authority",
          "justification"
        ],
        "properties": {
          "mutation_id": {
            "type": "string"
          },
          "agent_id": {
            "type": "string"
          },
          "authority": {
            "type": "string"
          },
          "justification": {
            "type": "string"
          },
          "timestamp_utc": {
            "type": "string",
            "format": "date-time"
          },
          "ledger_id": {
            "type": "string"
          },
          "mutation_type": {
            "type": "string"
          },
          "previous_content_hash": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "semantic_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rel",
          "target"
        ],
        "properties": {
          "rel": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}